{
  "name": "weihuda-hana",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "湖南大学微生活新前端 Hana 版",
  "author": "",
  "engines": {
    "node": ">=24"
  },
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "None",
    "framework": "Preact"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "tune": "node scripts/tune.ts",
    "dev": "pnpm tune && taro build --type weapp --watch",
    "build": "pnpm tune && taro build --type weapp",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "commitlint": "commitlint --edit",
    "mock": "tsx --env-file-if-exists=.env server/index.ts"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tanstack/preact-query": "^5.107.1",
    "@tarojs/components": "4.1.11",
    "@tarojs/helper": "4.1.11",
    "@tarojs/plugin-framework-react": "4.1.11",
    "@tarojs/plugin-platform-alipay": "4.1.11",
    "@tarojs/plugin-platform-h5": "4.1.11",
    "@tarojs/plugin-platform-harmony-hybrid": "4.1.11",
    "@tarojs/plugin-platform-jd": "4.1.11",
    "@tarojs/plugin-platform-qq": "4.1.11",
    "@tarojs/plugin-platform-swan": "4.1.11",
    "@tarojs/plugin-platform-tt": "4.1.11",
    "@tarojs/plugin-platform-weapp": "4.1.11",
    "@tarojs/runtime": "4.1.11",
    "@tarojs/shared": "4.1.11",
    "@tarojs/taro": "4.1.11",
    "@xtwis/ohnet": "^2.0.1",
    "lucide-react-taro": "^1.5.2",
    "preact": "~10.23.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@hono/node-server": "^2.1.8",
    "@prefresh/babel-plugin": "^0.5.1",
    "@prefresh/core": "^1.5.2",
    "@prefresh/webpack": "^4",
    "@sapporta/honest": "^0.3.18",
    "@sapporta/rest-core": "^3.52.2",
    "@tarojs/cli": "4.1.11",
    "@tarojs/plugin-generator": "4.1.11",
