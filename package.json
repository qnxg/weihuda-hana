    "@types/minimatch": "^5",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.1.11",
    "eslint": "10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "hono": "^4.13.18",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.5",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tsx": "^4.23.15",
    "tunewind": "^0.2.0",
