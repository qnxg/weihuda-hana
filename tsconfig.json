{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "allowJs": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["./src", "./types", "./config", "./scripts", "./tune.config.ts"],
  "compileOnSave": false
}
